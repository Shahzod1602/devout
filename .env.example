# Copy to .env on the dev server: /root/devout/.env
# .env is gitignored — never commit secrets.

# === Telegram bot tokens ===
BOT_TOKEN=
ERROR_BOT_TOKEN=
ERROR_GROUP_ID=

# === AI API keys ===
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# === Vertex AI (Gemini paperwork tahlili) ===
# Gemini endi API key emas, Vertex AI (service account) orqali chaqiriladi.
# Local/dev'da `GOOGLE_APPLICATION_CREDENTIALS` ni vertex key yo'liga qarating
# (default: /Users/shahzod/vertex-keys/vertex-server-key.json). Override:
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1

# === Backend API login ===
LOGIN_EMAIL=
LOGIN_PASSWORD=

# === Control-plane auth (audit v3 H2 — dark-launch) ===
# Backend webhook endpointlari (api/routes.py) uchun shared-secret.
# Bo'sh → auth O'CHIQ (default). Backend X-Api-Key yubora boshlagach kalitni
# o'rnatib, kuzatuvdan (MONITOR log) so'ng ENFORCE=1 ga o'ting.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_AUTH_ENFORCE=0

# === Environment ===
ENV_LABEL=devout
BOT_PORT=8045

# === Backend (DEV) ===
BASE_URL=https://api.dev.abstract-it.uz/api
SLEEP_TIMER_PATH=/v1/drivers/sleep-timer/by-group

# === AskAI (test askai is shared across envs) ===
VERIFY_DELIVERY_URL=https://askai.test.abstract-it.uz/verify-delivery

# === Logging ===
LOG_FORMAT=json
LOG_LEVEL=INFO

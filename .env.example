# Copy to .env on the dev server: /root/devout/.env
# .env is gitignored — never commit secrets.

# === Telegram bot tokens ===
BOT_TOKEN=
ERROR_BOT_TOKEN=
ERROR_GROUP_ID=

# === AI API keys ===
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# === Backend API login ===
LOGIN_EMAIL=
LOGIN_PASSWORD=

# === Environment ===
ENV_LABEL=devout
BOT_PORT=8045

# === Backend (DEV) ===
BASE_URL=https://api.dev.abstract-it.uz/api
SLEEP_TIMER_PATH=/v1/drivers/sleep-timer/by-group

# === AskAI (test askai is shared across envs) ===
VERIFY_DELIVERY_URL=https://askai.test.abstract-it.uz/verify-delivery

# === Logging ===
LOG_FORMAT=json
LOG_LEVEL=INFO
